// G13（2026-11-07）：本机开发签名。用法：make build-app DEV_SIGN_TEAM=<Team ID>（或 make test-app DEV_SIGN_TEAM=…），Makefile 把本文件
// 以 -xcconfig 传给 xcodebuild、Team ID 以 DEV_SIGN_TEAM 传进来。目的：用钥匙串里的 Apple Development 身份签出稳定的 Team ID + bundle id，
// TCC（摄像头 / 麦克风 / 屏幕录制）的授权跨重编译不再重问（ad-hoc 签名每次编译 CDHash 都变、系统当成新 App）。
// 不走描述文件、不带受限权限：Personal Team（免费 Apple ID）也能签；虚拟摄像头扩展照旧编得出、装不上。
// 不改 project.yml（归 W4-B / bump-version）：这里的设置按 xcodebuild 的优先级盖过工程里的 CODE_SIGN_IDENTITY "-" / CODE_SIGN_ENTITLEMENTS。
DEVELOPMENT_TEAM = $(DEV_SIGN_TEAM)
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Development
PROVISIONING_PROFILE_SPECIFIER =
// 按 target 选权限表：App 用开发表、扩展用它自己的（沙盒 + app group，不受限）、测试包不带
SW_DEV_ENT_Switcher = scripts/dev-signing/PlusMix-dev.entitlements
SW_DEV_ENT_SwitcherCameraExtension = CameraExtension/CameraExtension.entitlements
SW_DEV_ENT_SwitcherTests =
CODE_SIGN_ENTITLEMENTS = $(SW_DEV_ENT_$(TARGET_NAME))
